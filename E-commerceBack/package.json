    "@medusajs/framework": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "@medusajs/notification": "^2.13.1",
    "@medusajs/utils": "^2.13.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cloudinary": "^2.9.0",
